{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GrandVi/training-plan/main/schemas/plan.schema.json",
  "$defs": {
    "ActivityType": {
      "description": "intervals.icu activity type.",
      "enum": [
        "Ride",
        "MountainBikeRide",
        "Run",
        "WeightTraining"
      ],
      "title": "ActivityType",
      "type": "string"
    },
    "Amendment": {
      "description": "A change requested on a running plan, kept in Plan.amendments (see amend.py).\n\nSession amendments edit, skip or move the session planned on `date`; their result\nis pinned in the plan. Strength amendments do the same for the strength session of\n`date` (minutes, skip, move, equipment). Unavailable amendments add a calendar exception\nfrom `date` to `to` (inclusive). A later amendment of the same session supersedes the\nearlier one; both stay in the log.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AmendmentKind",
          "default": "session"
        },
        "created": {
          "format": "date",
          "title": "Created",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        },
        "skip": {
          "default": false,
          "title": "Skip",
          "type": "boolean"
        },
        "move_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Move To"
        },
        "minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes"
        },
        "sport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "activity": {
          "anyOf": [
            {
              "$ref": "#/$defs/BikeActivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Intent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "day_minutes": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Sport"
          },
          "title": "Day Minutes",
          "type": "object"
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "default": "rest"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "force": {
          "default": false,
          "title": "Force",
          "type": "boolean"
        },
        "original": {
          "anyOf": [
            {
              "$ref": "#/$defs/Session"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replaces": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaces"
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Superseded By"
        },
        "equipment": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Equipment"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equipment"
        },
        "original_strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrengthSession"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "created",
        "date"
      ],
      "title": "Amendment",
      "type": "object"
    },
    "AmendmentKind": {
      "enum": [
        "session",
        "unavailable",
        "strength"
      ],
      "title": "AmendmentKind",
      "type": "string"
    },
    "BikeActivity": {
      "description": "Kind of bike session a day allows (calendar exceptions, amendments).",
      "enum": [
        "road",
        "mtb",
        "trainer"
      ],
      "title": "BikeActivity",
      "type": "string"
    },
    "Equipment": {
      "description": "Strength equipment; bodyweight is always available.",
      "enum": [
        "bodyweight",
        "dumbbells",
        "barbell",
        "kettlebell",
        "bands",
        "pullup_bar",
        "machines"
      ],
      "title": "Equipment",
      "type": "string"
    },
    "Exercise": {
      "description": "One exercise of a strength session: sets x reps (or seconds) at a reps-in-reserve.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "$ref": "#/$defs/Pattern"
        },
        "sets": {
          "minimum": 1,
          "title": "Sets",
          "type": "integer"
        },
        "reps": {
          "minimum": 1,
          "title": "Reps",
          "type": "integer"
        },
        "unit": {
          "default": "reps",
          "enum": [
            "reps",
            "s"
          ],
          "title": "Unit",
          "type": "string"
        },
        "rir": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rir"
        },
        "per_side": {
          "default": false,
          "title": "Per Side",
          "type": "boolean"
        },
        "accessory": {
          "default": false,
          "title": "Accessory",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "pattern",
        "sets",
        "reps"
      ],
      "title": "Exercise",
      "type": "object"
    },
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/GoalType"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "A"
        },
        "sport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "$ref": "#/$defs/GoalTarget"
        }
      },
      "required": [
        "name",
        "date",
        "type"
      ],
      "title": "Goal",
      "type": "object"
    },
    "GoalTarget": {
      "additionalProperties": false,
      "properties": {
        "time": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "pattern": "^\\d+:\\d{2}(:\\d{2})?$",
                  "type": "string"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                }
              ],
              "description": "'m:ss' or 'h:mm:ss' (quoted), or seconds"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "duration_h": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration H"
        },
        "distance_km": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km"
        },
        "elevation_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation M"
        }
      },
      "title": "GoalTarget",
      "type": "object"
    },
    "GoalType": {
      "enum": [
        "run_5k",
        "run_10k",
        "run_half_marathon",
        "mtb_xc",
        "mtb_marathon",
        "ultra_endurance"
      ],
      "title": "GoalType",
      "type": "string"
    },
    "Intent": {
      "description": "Physiological intent, preserved when a session is swapped to the other sport.",
      "enum": [
        "recovery",
        "endurance",
        "tempo",
        "sweet_spot",
        "threshold",
        "vo2max",
        "anaerobic",
        "race_specific",
        "technical"
      ],
      "title": "Intent",
      "type": "string"
    },
    "Issue": {
      "properties": {
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "week": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Week"
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Pattern": {
      "description": "Movement pattern of a strength exercise.",
      "enum": [
        "squat",
        "hinge",
        "single_leg",
        "push",
        "pull",
        "calf",
        "core"
      ],
      "title": "Pattern",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "base",
        "build",
        "peak",
        "taper",
        "transition"
      ],
      "title": "Phase",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Priority",
      "type": "string"
    },
    "Repeat": {
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "steps": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Step"
              },
              {
                "$ref": "#/$defs/Repeat"
              }
            ]
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "count",
        "steps"
      ],
      "title": "Repeat",
      "type": "object"
    },
    "ResolvedTarget": {
      "description": "Absolute values of a Target for the current thresholds.",
      "properties": {
        "power_w": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power W"
        },
        "pace_s_per_km": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pace S Per Km"
        },
        "hr_bpm": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hr Bpm"
        }
      },
      "title": "ResolvedTarget",
      "type": "object"
    },
    "Scope": {
      "description": "How much of a running plan an amendment rebuilds (see amend.py).",
      "enum": [
        "session",
        "week",
        "rest"
      ],
      "title": "Scope",
      "type": "string"
    },
    "Session": {
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "sport": {
          "$ref": "#/$defs/Sport"
        },
        "activity_type": {
          "$ref": "#/$defs/ActivityType"
        },
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "steps": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Step"
              },
              {
                "$ref": "#/$defs/Repeat"
              }
            ]
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Id"
        },
        "indoor": {
          "default": false,
          "title": "Indoor",
          "type": "boolean"
        },
        "technical": {
          "default": false,
          "title": "Technical",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "rung": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rung"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "amendment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amendment Id"
        },
        "duration_s": {
          "readOnly": true,
          "title": "Duration S",
          "type": "integer"
        },
        "tss": {
          "readOnly": true,
          "title": "Tss",
          "type": "number"
        }
      },
      "required": [
        "date",
        "sport",
        "activity_type",
        "slot",
        "intent",
        "name",
        "steps",
        "rationale",
        "duration_s",
        "tss"
      ],
      "title": "Session",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Slot": {
      "description": "Sport-agnostic role of a session in the week.",
      "enum": [
        "key_1",
        "key_2",
        "key_3",
        "long",
        "long_2",
        "easy"
      ],
      "title": "Slot",
      "type": "string"
    },
    "Sport": {
      "enum": [
        "bike",
        "run"
      ],
      "title": "Sport",
      "type": "string"
    },
    "Step": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/StepKind",
          "default": "work"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "integer"
        },
        "distance_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance M"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "duration_s",
        "target"
      ],
      "title": "Step",
      "type": "object"
    },
    "StepKind": {
      "enum": [
        "warmup",
        "work",
        "recovery",
        "cooldown"
      ],
      "title": "StepKind",
      "type": "string"
    },
    "StrengthSession": {
      "description": "A strength session (not a Sport: it stays out of the endurance load and ramp caps).",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "variant": {
          "default": "full",
          "title": "Variant",
          "type": "string"
        },
        "exercises": {
          "items": {
            "$ref": "#/$defs/Exercise"
          },
          "minItems": 1,
          "title": "Exercises",
          "type": "array"
        },
        "minutes": {
          "minimum": 1,
          "title": "Minutes",
          "type": "integer"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "equipment_used": {
          "items": {
            "$ref": "#/$defs/Equipment"
          },
          "title": "Equipment Used",
          "type": "array"
        },
        "rung": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rung"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "amendment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amendment Id"
        }
      },
      "required": [
        "date",
        "name",
        "phase",
        "template_id",
        "exercises",
        "minutes",
        "rationale"
      ],
      "title": "StrengthSession",
      "type": "object"
    },
    "Target": {
      "description": "Relative intensity range.\n\npower: fraction of FTP; pace: fraction of threshold speed; hr: fraction of\nLTHR; rpe: 1-10.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "low",
        "high"
      ],
      "title": "Target",
      "type": "object"
    },
    "TargetKind": {
      "description": "Unit of a relative target (see models.plan.Target).",
      "enum": [
        "power",
        "pace",
        "hr",
        "rpe"
      ],
      "title": "TargetKind",
      "type": "string"
    },
    "Week": {
      "properties": {
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "recovery": {
          "default": false,
          "title": "Recovery",
          "type": "boolean"
        },
        "goal": {
          "default": "",
          "title": "Goal",
          "type": "string"
        },
        "races": {
          "items": {
            "type": "string"
          },
          "title": "Races",
          "type": "array"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/Session"
          },
          "title": "Sessions",
          "type": "array"
        },
        "strength": {
          "items": {
            "$ref": "#/$defs/StrengthSession"
          },
          "title": "Strength",
          "type": "array"
        },
        "duration_s": {
          "readOnly": true,
          "title": "Duration S",
          "type": "integer"
        },
        "tss": {
          "readOnly": true,
          "title": "Tss",
          "type": "number"
        }
      },
      "required": [
        "index",
        "start",
        "phase",
        "duration_s",
        "tss"
      ],
      "title": "Week",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "created": {
      "format": "date",
      "title": "Created",
      "type": "string"
    },
    "athlete": {
      "title": "Athlete",
      "type": "string"
    },
    "goals": {
      "items": {
        "$ref": "#/$defs/Goal"
      },
      "title": "Goals",
      "type": "array"
    },
    "weeks": {
      "items": {
        "$ref": "#/$defs/Week"
      },
      "title": "Weeks",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Warnings",
      "type": "array"
    },
    "amendments": {
      "items": {
        "$ref": "#/$defs/Amendment"
      },
      "title": "Amendments",
      "type": "array"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "created",
    "athlete",
    "goals",
    "weeks"
  ],
  "title": "Plan",
  "type": "object"
}
