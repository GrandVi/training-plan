# Environment of the endurance-planner service. Copy to /etc/endurance-planner.env,
# owned by root, mode 600 (systemd reads it before dropping privileges):
#   sudo install -m 600 -o root -g root deploy/endurance-planner.env.example /etc/endurance-planner.env
# Never commit the real file.

# Access token of the API and the web app (required, 16+ characters). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The server refuses to start while it is empty.
PLANNER_TOKEN=

# Data directory: profile.yaml (edited by hand) and the plans written by the server.
PLANNER_DATA_DIR=/var/lib/endurance-planner

# intervals.icu (optional: without a key, push is unavailable in the app). Settings >
# Developer Settings in intervals.icu. Read by the server only, never sent to clients.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
